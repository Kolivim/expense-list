<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Нижний слой: тень -->
    <item>
        <shape>
            <solid android:color="#E0E0E0" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <!-- Верхний слой: основной фон, смещенный вверх и влево -->
    <item
        android:left="2dp"
        android:top="2dp">
        <shape>
            <solid android:color="#FFFFFF" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</layer-list>