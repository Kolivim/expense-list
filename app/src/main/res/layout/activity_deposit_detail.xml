<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@android:drawable/edit_text"
        android:padding="12dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/textViewDepositName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="Название взноса"/>

        <TextView
            android:id="@+id/textViewDepositDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:text="Описание"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/textViewDepositDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:text="Дата"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/textViewDepositMonth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:text="Месяц"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/textViewDepositTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:text="Общая сумма: 0.00 руб."
            android:layout_marginTop="8dp"
            android:textColor="#4CAF50"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Платежи:"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <ListView
        android:id="@+id/listViewDepositPayments"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:drawable/edit_text"
        android:padding="8dp">

        <EditText
            android:id="@+id/editTextNewDepositPayment"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Введите сумму"
            android:inputType="numberDecimal|numberSigned"
            android:padding="8dp"/>

        <Button
            android:id="@+id/buttonAddDepositPayment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Добавить"
            android:backgroundTint="#4CAF50"
            android:layout_marginStart="8dp"/>
    </LinearLayout>

    <Button
        android:id="@+id/buttonChooseTextColor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Выбрать цвет текста"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/buttonEditDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Редактировать описание"
        android:layout_marginTop="8dp"/>

    <Button
        android:id="@+id/buttonBack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Назад"
        android:layout_marginTop="16dp"/>

</LinearLayout>