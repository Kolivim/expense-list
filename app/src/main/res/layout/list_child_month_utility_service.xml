<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="12dp"
    android:paddingStart="32dp"
    android:paddingTop="0dp"
    android:layout_marginTop="12dp"
    android:background="?android:attr/selectableItemBackground">

    <!--
    Левый блок: вся информация о Expense,
    включая Deposit к ней (занимает всё оставшееся место)
    -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/rounded_edittext_bg" >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/textViewExpenseInfo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/textViewExpenseDate"
                app:layout_constraintTop_toTopOf="parent"
                />

            <TextView
                android:id="@+id/textViewExpenseDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#666666"
                android:maxWidth="70dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                android:layout_marginStart="8dp" />

            <TextView
                android:id="@+id/textViewExpenseAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#2196F3"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/textViewExpenseInfo" />

        </androidx.constraintlayout.widget.ConstraintLayout>


        <!--   Для Deposit     -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/depositContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" >

            <TextView
                android:id="@+id/textViewDepositAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textColor="#2196F3"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                />

        </androidx.constraintlayout.widget.ConstraintLayout>
        <!--   !Для Deposit     -->


        <TextView
            android:id="@+id/textViewBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="#2196F3"
            android:layout_marginTop="4dp" />

    </LinearLayout>


    <!-- Правый блок: кнопки -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="2dp">


        <!--
        Запускается активити с добавлением нового взноса (все основные поля) и
        кнопками внизу ОК, Список взносов, Назад. Кнопка Список взносов запускает другую активити,
        где доступен построчно список Взносов и есть кнопки для их редактирования / удаления (выбранной) -
        аналогично уже имеющимся реализациям
        -->
        <Button
            android:id="@+id/deposit"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="36dp"
            android:padding="8dp"
            android:layout_marginTop="0dp"
            android:layout_gravity="center_horizontal"
            android:textSize="10sp"
            android:text="Взносы"
            android:backgroundTint="@color/dark_orange"/>

    </LinearLayout>



    <!-- Контейнер для показаний счётчиков -->
    <LinearLayout
        android:id="@+id/meterReadingsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:visibility="gone"> <!-- По умолчанию скрыт -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Показания счётчиков"
            android:textStyle="bold" />

        <ListView
            android:id="@+id/readingsListView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>

    <TextView
        android:id="@+id/noReadingsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Нет показаний"
        android:visibility="gone" />


</LinearLayout>


